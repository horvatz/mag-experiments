(version 1)
(allow default)
(deny file-read-data (require-not (require-any (literal "/") (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/dev") (subpath "/private/etc") (subpath "/private/var/db/timezone") (subpath "/Library/Fonts") (subpath "/Users/zan/.nvm/versions/node/v24.11.1") (subpath "/Users/zan/Library/Caches/ms-playwright") (subpath "/Users/zan/Documents/mag/experiments/.work/pilots/P02-C-001/app"))))
(deny file-write* (require-not (require-any (subpath "/Users/zan/Documents/mag/experiments/.work/pilots/P02-C-001/app/.tmp/browser") (subpath "/dev"))))
(deny network*)
(allow network-bind (local ip "*:9223"))
(allow network-inbound (local ip "localhost:9223"))
(allow network-outbound (remote tcp "localhost:5174") (remote tcp "localhost:3102") (remote tcp "localhost:5193") (remote tcp "localhost:3123"))
