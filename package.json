{
  "name": "mag-experiments",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "prepare:reference": "node scripts/prepare-reference.mjs",
    "dev:reference": "node scripts/start-app.mjs",
    "test:reference": "node scripts/verify-reference.mjs",
    "test:development": "playwright test --project=development-desktop --project=development-mobile",
    "test:evaluation": "playwright test --project=evaluation-desktop --project=evaluation-mobile",
    "test:mutations": "node scripts/check-mutations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "pilot:prepare": "node scripts/prepare-pilot.mjs",
    "pilot:browser": "node scripts/pilot-browser.mjs",
    "pilot:preflight": "node scripts/preflight-pilot.mjs",
    "pilot:run": "node scripts/run-pilot.mjs",
    "pilot:evaluate": "node scripts/evaluate-pilot.mjs",
    "pilot:archive": "node scripts/archive-pilot.mjs",
    "test:runner": "node --test scripts/pilot-utils.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
